# Supabase Configuration (Required for live database & authentication)
# Leave blank to run BizAssist AI in interactive Demo Mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Server-Side AI API Key for BizAssist Assistant Chatbot
# Supports either OpenAI or Google Gemini (never exposed to frontend)
OPENAI_API_KEY=
GEMINI_API_KEY=
